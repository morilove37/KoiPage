{
  "name": "galgame-manager",
  "private": true,
  "version": "0.6.1",
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:ipc": "node scripts/check-ipc-contract.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:share": "node --test tests/share-model.test.mjs",
    "test:announcements": "node --test tests/announcements.test.mjs",
    "test:home-play-time": "node --test tests/home-play-time.test.mjs tests/play-time-calendar.test.mjs",
    "test:birthdays": "node --test tests/birthdays.test.mjs",
    "test:covers": "node --test tests/cover-preferences.test.mjs",
    "test:metadata": "node --test tests/metadata-preferences.test.mjs",
    "test:logs": "node --test tests/log-model.test.mjs tests/logging-runtime.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@tauri-apps/plugin-fs": "2.7.0",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-sql": "2.6.0",
    "@tauri-apps/plugin-updater": "2.14.0",
    "clsx": "^2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "tailwind-merge": "^3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
