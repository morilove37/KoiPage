{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "fs:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "clipboard-manager:allow-write-image",
    "clipboard-manager:allow-write-text"
  ]
}
